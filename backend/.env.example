# Copier ce fichier en .env et le remplir. Ne JAMAIS versionner le .env.

# Chaîne de connexion PostgreSQL du projet Supabase (fournie par l'équipe 5) :
# Supabase > Connect > Connection string (Session pooler)
DATABASE_URL=postgresql://postgres.xxxxxxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# Secret de signature des jetons JWT (une longue chaîne aléatoire)
JWT_SECRET=a-changer-en-production

# false pendant le développement et l'intégration avec le front ; true en production
AUTH_ENABLED=false

# Origines du front autorisées (séparées par des virgules), * = toutes
CORS_ORIGINS=*

# Module Python du moteur OR-Tools (tâche 2)
MOTEUR_MODULE=moteur_ortools
